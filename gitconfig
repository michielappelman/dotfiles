[user]
  email = michiel@appelman.se
  name = Michiel Appelman
[shell]
  username = mike
[github]
  user = michielappelman
[includeIf "gitdir:~/cf/"]
  path = ~/cf/.gitconfig

[init]
  defaultBranch = main
[core]
  excludesfile = ~/.gitignore

[merge]
  ff = no
  commit = no
[pull]
  rebase = true
[rebase]
  autoStash = true
[push]
  default = simple

[alias]
  l = log --pretty=format:"%C(yellow)%h\\ %ad%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --date=short --graph
  ll = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --numstat
  co = checkout
  cob = checkout -b
  sw = !git checkout $(git branch -a --format '%(refname:short)' | sed 's~origin/~~' | sort | uniq | fzf)
  fs = !git fetch --all && git status -s
  st = status -s
  br = branch -av
  unstage = reset HEAD --
  subup = submodule update --init
  subpull = submodule foreach git pull
  aliases = !git config --list | grep 'alias\\.' | sed 's/alias\\.\\([^=]*\\)=\\(.*\\)/\\1\\ \t => \\2/' | sort
